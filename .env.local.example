# Clé secrète Stripe (mode TEST) — Dashboard Stripe → Développeurs → Clés API
# Commence par sk_test_...
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_ici

# Clé publique Stripe (mode TEST) — utilisée côté navigateur pour Stripe Elements
# Commence par pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_ici

# URL de base du site, utilisée pour construire les URLs de retour Stripe.
# En local : http://localhost:3000
# En production : https://votre-domaine.fr
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Facturation électronique (Factur-X) — facultatif ──
# SIREN et n° de TVA intracommunautaire de Prolocal-Landes, affichés sur
# les factures générées (émetteur). Laissez vide si non applicable.
PROLOCAL_SIREN=
PROLOCAL_VAT_NUMBER=

# ── Envoi d'email des factures (XML) — facultatif ──
# Clé API Resend (https://resend.com, offre gratuite disponible) pour
# l'envoi réel des factures par email. Sans cette clé, l'envoi fonctionne
# en mode démonstration (aucun email n'est réellement envoyé).
RESEND_API_KEY=
INVOICE_SENDER_EMAIL=factures@prolocal-landes.fr

# ── Base de données (étape 1 de la migration hors localStorage) — facultatif ──
# Injectée automatiquement par Vercel lorsqu'un projet Postgres est relié
# au site (Vercel Dashboard → Storage → Create Database → Postgres).
# Aucune valeur à renseigner manuellement en production. En local, copiez
# la valeur "POSTGRES_URL" depuis l'onglet .env.local de votre base Vercel.
POSTGRES_URL=

# ── Synchronisation quotidienne SIRENE (base entreprises des Landes) ──
# Clé secrète protégeant la route /api/cron/sync-sirene contre un
# déclenchement externe non autorisé. Générez une valeur aléatoire longue
# (ex: `openssl rand -hex 32`) et renseignez-la aussi dans Vercel Dashboard
# → Project → Settings → Environment Variables. Vercel Cron l'envoie
# automatiquement dans l'en-tête Authorization à chaque exécution planifiée
# (voir vercel.json).
CRON_SECRET=

# ── Identifiants de l'espace admin ──
# Vérifiés côté serveur par /api/admin/login (voir src/app/api/admin/login/
# route.ts) — aucun identifiant n'est codé en dur dans le code source.
# Renseignez-les aussi dans Vercel Dashboard → Project → Settings →
# Environment Variables. Sans ces deux variables, la connexion admin est
# désactivée (503).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Chemin secret de l'espace admin ──
# L'espace admin n'est plus accessible via /admin (qui renvoie désormais
# une erreur 404) : il faut passer par le chemin défini ici, réécrit en
# interne par le middleware (voir src/middleware.ts). Choisissez une valeur
# longue et peu devinable, SANS le "/" du début (ex: admin-x7k2p9). Cette
# valeur ne doit jamais être commitée ni partagée publiquement — renseignez-
# la aussi dans Vercel Dashboard → Project → Settings → Environment
# Variables. Si elle n'est pas définie, l'espace admin est inaccessible.
ADMIN_SECRET_PATH=

# ── Avis Google dans les fiches professionnelles (SEO) — facultatif ──
# Nécessite l'activation de "Places API (New)" sur Google Cloud Console,
# avec facturation activée sur le projet (le champ note/nb d'avis reste
# généralement dans le niveau gratuit pour un usage à faible volume, mais
# reste soumis aux tarifs Google). Sans cette clé, les fiches fonctionnent
# normalement — simplement sans note Google fusionnée dans les données
# structurées SEO (seuls les avis internes Prolocal-Landes apparaissent).
GOOGLE_PLACES_API_KEY=
